/**
 * Second version – correct order. We'll overwrite runRemediation above.
 * For brevity, we'll define a new function and export it.
 */
export async function runRemediationCorrect(config: RemediationConfig): Promise<number> {
  const {
    leakedToken,
    gitlabUrl,
    repoRoot,
    exposedFilePath,
    newTokenName,
    newTokenExpiry,
    newTokenScopes,
    dryRun,
    scrubHistory,
  } = config;

  logger.info('Starting remediation workflow (correct order)', {
    gitlabUrl,
    repoRoot,
    exposedFilePath,
    dryRun,
    scrubHistory,
  });

  try {
    // Validate repo root
    const repoStat = await fs.stat(repoRoot);
    if (!repoStat.isDirectory()) {
      throw new RemediationError(`Repo root is not a directory: ${repoRoot}`);
    }

    // Create client with leaked token
    const client = createGitlabClient(gitlabUrl, leakedToken);

    // Step 1: Validate token
    const userInfo = await validateToken(client);
    logger.info('Authenticated as', { username: userInfo.username });

    if (dryRun) {
      logger.info('DRY RUN – skipping actual changes');
      logger.info('Would create token:', { name: newTokenName, scopes: newTokenScopes, expiresAt: newTokenExpiry });
      logger.info('Would revoke token for user:', userInfo.username);
      logger.info('Would append to .gitignore:', exposedFilePath);
      if (scrubHistory) logger.info('Would scrub history for:', exposedFilePath);
      return 0;
    }

    // Step 2: Create new token first (while old token is still active)
    logger.info('Creating replacement token...');
    const newTokenData = await createToken(client, newTokenName, newTokenScopes, newTokenExpiry);
    const newToken = newTokenData.token;

    // Step 3: Write new token to secure file
    const tokenFilePath = await writeTokenFile(repoRoot, newToken);
    logger.info(`New token saved to ${tokenFilePath}`);
    // Also output to console only the file path (not the token itself)
    console.log('REPLACEMENT_TOKEN_FILE=' + tokenFilePath);
    // Provide instructions to move to secret store
    logger.warn('Immediately move the token from the file to a secure secret store (e.g., 1Password, vault, CI secret).');

    // Step 4: Revoke the leaked token
    logger.info('Revoking leaked token...');
    await revokeLeakedToken(client);
    logger.info('Leaked token revoked');

    // Step 5: Append exposed file to .gitignore
    logger.info('Updating .gitignore...');
    await updateGitignore(repoRoot, exposedFilePath);

    // Step 6: Optional git history scrub
    if (scrubHistory) {
      const scrubbed = await scrubGitHistory(repoRoot, exposedFilePath, true);
      if (scrubbed) {
        logger.info('History scrub completed');
      } else {
        logger.info('History scrub skipped or failed');
      }
    }

    logger.info('All remediation steps completed successfully.');
    return 0;
  } catch (error) {
    if (error instanceof RemediationError) {
      logger.error('Remediation failed', { error: error.message, stack: error.stack });
    } else if (error instanceof Error) {
      logger.error('Unexpected error', { error: error.message, stack: error.stack });
    } else {
      logger.error('Unknown error', { error: String(error) });
    }
    return 1;
  }
}

// Re-export the corrected function as main entry
export const runRemediation = runRemediationCorrect;

/* ------------------------------------------------------------------ */
/*  CLI Entry Point                                                    */
/* ------------------------------------------------------------------ */

/**
 * If executed directly, parse config from environment variables.
 */
if (require.main === module) {
  (async () => {
    const requiredEnvVars = ['LEAKED_TOKEN', 'GITLAB_URL', 'REPO_ROOT'];
    const missing = requiredEnvVars.filter((v) => !process.env[v]);
    if (missing.length > 0) {
      console.error(`Missing required environment variables: ${missing.join(', ')}`);
      process.exit(1);
    }

    const rawConfig = {
      leakedToken: process.env.LEAKED_TOKEN!,
      gitlabUrl: process.env.GITLAB_URL!,
      repoRoot: process.env.REPO_ROOT!,
      exposedFilePath: process.env.EXPOSED_FILE_PATH ?? DEFAULT_EXPOSED_FILE,
      newTokenName: process.env.NEW_TOKEN_NAME ?? DEFAULT_TOKEN_NAME,
      newTokenExpiry: process.env.NEW_TOKEN_EXPIRY,
      newTokenScopes: process.env.NEW_TOKEN_SCOPES
        ? process.env.NEW_TOKEN_SCOPES.split(',')
        : [...DEFAULT_SCOPES],
      dryRun: process.env.DRY_RUN === 'true',
      scrubHistory: process.env.SCRUB_HISTORY === 'true',
    };

    try {
      const config = validateConfig(rawConfig);
      const exitCode = await runRemediation(config);
      process.exit(exitCode);
    } catch (error) {
      if (error instanceof ConfigurationError) {
        console.error(error.message);
        if (error.details) {
          console.error(error.details.errors);
        }
      } else {
        console.error('Fatal error:', error);
      }
      process.exit(1);
    }
  })();
}